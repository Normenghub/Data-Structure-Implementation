#include <list>
#include <iterator>
using namespace std;


template <typename E, typename C> //Interface
class ListPrioirtyQueue{
public:
    int size() const;
    bool empty() const;
    void insert(const E& e);
    const E& min() const;
    void removeMin();
    
    
private:
    list<E> L;
    C isLess;
    
};

template <typename E, typename C>
int ListPrioirtyQueue<E,C>::size() const
{
    return L.size();
}

template <typename E, typename C>
bool ListPrioirtyQueue<E,C>::empty() const{
    return L.rempty();
}

template <typename E, typename C>
void ListPrioirtyQueue<E,C>:: insert(const E& e){
    typename list<E>::iterator p;
    p = L.begin();
    while(p != L.end() && !isLess(e, *p)) ++p;
    L.insert(p, e);
}

template <typename E, typename C>
const E& ListPrioirtyQueue<E,C>::min() const{
    return L.front();
}

template <typename E, typename C>

void ListPrioirtyQueue<E,C>::removeMin(){
    L.pop_front();
}


